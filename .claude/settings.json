{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",

      "Bash(dotnet build)",
      "Bash(dotnet build *)",
      "Bash(dotnet test)",
      "Bash(dotnet test *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",

      "PowerShell(dotnet build)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test)",
      "PowerShell(dotnet test *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)"
    ],
    "deny": [
      "Bash(mysql)",
      "Bash(mysql *)",
      "Bash(mysql.exe *)",
      "Bash(mysqlsh *)",
      "Bash(sqlcmd *)",
      "Bash(dotnet ef database *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -Rf *)",

      "PowerShell(mysql)",
      "PowerShell(mysql *)",
      "PowerShell(mysql.exe *)",
      "PowerShell(mysqlsh *)",
      "PowerShell(sqlcmd *)",
      "PowerShell(Invoke-Sqlcmd *)",
      "PowerShell(dotnet ef database *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(Remove-Item *-r *)",
      "PowerShell(rm *-Recurse*)",
      "PowerShell(del *-Recurse*)",
      "PowerShell(ri *-Recurse*)",
      "PowerShell(rmdir *-Recurse*)",
      "PowerShell(rm -rf *)"
    ]
  }
}
